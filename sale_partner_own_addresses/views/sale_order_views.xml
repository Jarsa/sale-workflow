<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form (in sale_partner_own_addresses)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('parent_id', '=', False)]</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="partner_invoice_domain" invisible="1" />
                <field name="partner_shipping_domain" invisible="1" />
            </field>
            <field name="partner_invoice_id" position="attributes">
                <attribute name="domain">partner_invoice_domain</attribute>
            </field>
            <field name="partner_shipping_id" position="attributes">
                <attribute name="domain">partner_shipping_domain</attribute>
            </field>
        </field>
    </record>
</odoo>
